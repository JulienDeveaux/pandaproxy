# PandaProxy environment configuration
# Copy this file to .env and fill in your values

# Required: IP address of your BambuLab printer
PRINTER_IP=192.168.1.100

# Required: Access code from your printer (Settings > Network > Access Code)
ACCESS_CODE=12345678

# Required: Serial number of your printer (Settings > Network > Serial Number)
SERIAL_NUMBER=01A12B2C

# Address to bind the proxy server to (default: 0.0.0.0)
BIND_ADDRESS=0.0.0.0

# Services to enable (comma-separated list, default: camera)
SERVICES=""

# Optional: Enable all services (overrides SERVICES variable)
ENABLE_ALL=False

# Address advertised to clients, used in FTP PASV replies and as the printer
# address in MQTT reports. Leave empty on host or macvlan networking, where the
# socket's own address is already correct.
# REQUIRED with Docker bridge networking and published ports: set it to the
# Docker host's LAN address. Otherwise clients are told the printer lives at
# the container's private address (e.g. 172.18.0.2) and every transfer fails.
ADVERTISE_IP=

# Passive FTP data port range. Must match the ports published to the container.
FTP_DATA_PORT_START=2000
FTP_DATA_PORT_END=2019

# BambuStudio ne compose que des adresses qu'il a vues annoncees sur UDP 2021 :
# sans cela il ne peut pas atteindre le proxy, quoi qu'on saisisse a la main.
#
# Liste d'adresses a qui envoyer l'annonce, separees par des virgules —
# typiquement les machines qui font tourner un slicer. Un conteneur sur un
# bridge Docker ne peut pas diffuser sur le LAN, mais il peut leur envoyer en
# unicast. Mettre "broadcast" en reseau host ou macvlan. Vide = desactive.
SSDP_TARGETS=

# Code modele annonce. C12 = P1S (voir printers/C12.json de BambuStudio).
SSDP_DEV_MODEL=C12

# Nom affiche dans la liste des appareils du slicer.
SSDP_DEV_NAME=PandaProxy

# Intervalle entre annonces. Doit rester plus rapide que celles de
# l'imprimante, qui portent le meme numero de serie et se disputent l'entree.
SSDP_INTERVAL=2.0

# Firmware version announced over SSDP. BambuStudio refuses an announcement
# with an empty version, so the proxy stays silent until MQTT reports one.
# Set this to announce immediately instead of waiting.
SSDP_DEV_VERSION=
